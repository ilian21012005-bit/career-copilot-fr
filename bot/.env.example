# Copier ce fichier en .env et remplir. Ne pas commiter .env.
# Ne pas coller ces valeurs dans le chat.

FT_CLIENT_ID=
FT_CLIENT_SECRET=

GMAIL_ADDRESS=your.address@example.com
GMAIL_APP_PASSWORD=

# Optionnel. Sans ces deux lignes, le script tourne avec La Bonne Boîte et ROMEO.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optionnel. Clé gratuite : https://fr.jooble.org/api/about
# Jooble agrège d'autres sites français. Sans clé, seule Adzuna est utilisée.
JOOBLE_API_KEY=

# Telegram (notifications résumé / réponses). Ne jamais logger les valeurs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Sans TELEGRAM_ALLOWED_USER_IDS, le bot refuse toutes les commandes interactives.
TELEGRAM_ALLOWED_USER_IDS=

# IA désactivée par défaut pour éviter toute consommation de quota/coût.
# Le quota partagé des deux bots est de 250 appels/jour maximum si activé.
AI_ENABLED=0
AI_MAX_CALLS_PER_DAY=250

# 1 = le daemon systemd peut envoyer les mails éligibles du cycle. 0 = pas d'envoi auto.
AUTOPILOT_SEND=0
# Créneaux quotidiens (virgules) — défaut prod : 06:30,12:00,18:00
# SCHEDULE_TIME=06:30,12:00,18:00
